# Build output. Regenerated by every build and large enough to dominate a diff.
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Test and coverage output. TestResults holds a fresh GUID directory per run, so
# committing it would add a new directory on every test invocation.
[Tt]est[Rr]esults/
*.coverage
*.coverlet.json
coverage*.json
coverage*.xml
coverage*.info

# Tool and IDE state. .vs/ and .idea/ are per-machine caches; .vscode/ is not
# ignored, because a committed launch or tasks configuration is a team decision.
.vs/
.idea/
*.user
*.suo
*.userprefs
*.swp

# NuGet. Restored packages and the local fallback folder are re-downloadable;
# nuget.config is NOT ignored, because feed configuration is part of the build.
packages/
*.nupkg
*.snupkg

# Publish output and deployment scratch.
[Pp]ublish/
*.publishsettings
PublishScripts/

# Local user secrets that escaped the secret store, and machine-local overrides.
# The secret store lives outside the repository; anything matching here inside it
# is a mistake being caught rather than a file being managed.
appsettings.*.local.json
*.local.json
secrets.json

# .NET Interactive / Polyglot notebook checkpoints. The notebook itself IS
# committed; only the kernel's scratch state is not.
.ipynb_checkpoints/

# OS noise.
.DS_Store
Thumbs.db
