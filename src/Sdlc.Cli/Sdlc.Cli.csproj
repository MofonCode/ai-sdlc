<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sdlc</AssemblyName>
    <RootNamespace>Sdlc.Cli</RootNamespace>

    <!-- The gate ships and runs inside every governed solution, and a hook invokes it on a tool
         call, so start-up cost is on the critical path of every edit an agent makes. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>

    <!-- Packed as a dotnet tool: one command on PATH, restorable per solution, and the same
         binary the pre-tool hook, the git hooks and the pipeline all call. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sdlc</ToolCommandName>
    <PackageId>MofonCode.Sdlc.Cli</PackageId>

    <!-- Everything below is what a feed shows a person deciding whether to install this, and it is
         here rather than in Directory.Build.props because this is the only packable project. The
         defaults are not harmless: `authors` fell back to the assembly name and `description` to the
         literal string "Package Description", and a version pushed to nuget.org can be unlisted but
         never deleted - so the placeholder would have been permanent. -->
    <Authors>MofonCode</Authors>
    <Company>MofonCode</Company>
    <Title>ai-sdlc gate</Title>

    <!-- Opens with the framework's definition, worded as the README states it, and then describes the
         binary, which is not the same thing and is why the rest is not a copy of the plugin's
         description. The package is one of two halves: it decides, and the plugin carries the skills
         that ask it to. Somebody who installs only this gets a working gate and no stages, so the
         description says so. -->
    <!-- One line, unindented, because whitespace in here reaches the feed page verbatim. -->
    <Description>The deterministic half of ai-sdlc, which holds an AI coding agent, and the people directing it, to what was written down. Every change is planned before any code exists, challenged by a reader that never saw it written, approved by a person against the exact text, and proved from recorded evidence, against rules and decisions that live in the repository and carry from one cycle to the next. This is the `sdlc` command every host hook and pipeline step calls: it decides everything a program can, including the pull-request check that refuses a change whose chain is incomplete, unapproved or hash-mismatched. The stages need language and ship separately as the plugin.</Description>

    <PackageTags>sdlc;governance;constraints;decisions;code-review;agent;ai;hooks;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Sources and symbols, so a stack trace from somebody else's machine is readable. The gate
         runs inside other people's repositories on a hook path, which is the worst place to debug
         from a release build with nothing to go on. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's own readme, written for somebody who found the tool on a feed rather than for
         somebody reading the repository. Not the root README: that one describes both halves and
         links to guides, and a package consumer cannot follow a link into a private repository. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin, beside the binary, so the release a solution pins carries the skills written for it and
         'sdlc claude' starts a session with them (D-131). The same files a marketplace install takes. -->
    <None Include="..\..\skills\**\*" LinkBase="plugin\skills" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <None Include="..\..\hooks\**\*" LinkBase="plugin\hooks" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <None Include="..\..\.claude-plugin\**\*" LinkBase="plugin\.claude-plugin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <None Include="..\..\plugin.json;..\..\LICENSE" Link="plugin\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\Sdlc.Core\Sdlc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- An application exposes no API, so its types are internal and CA1515 is satisfied rather
         than suppressed. The suite asserts them directly: going through the process boundary for
         argument parsing would test the shell more than the parser. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Sdlc.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
