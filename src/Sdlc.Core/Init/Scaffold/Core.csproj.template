<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The kernel: a mediator, Result handlers, tracing, and the one shape allowed across a
         boundary. MIT, on nuget.org, and it depends on nothing but FluentResults and the
         Microsoft.Extensions abstractions - so taking it decides no data story for this solution.
         Pinned in Directory.Packages.props, because it is pre-1.0 and every consumer inherits its
         breaking changes. -->
    <PackageReference Include="MofonCode.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- The suite reaches the operations through the mediator like a host does, so nothing here needs
         to be public for a test to read it. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>__SOLUTION__.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
