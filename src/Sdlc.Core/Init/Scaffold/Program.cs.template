using System.Text.Json.Serialization;
using __SOLUTION__.Api.Greetings;
using __SOLUTION__.Application;

namespace __SOLUTION__.Api;

/// <summary>
/// The host. Composes the solution and maps the endpoints, and does nothing else.
/// </summary>
/// <remarks>
/// <para>One call to <c>Add__SOLUTION__</c> is the whole of what this host can reach: everything
/// inside the application project is private behind the mediator, so the service-collection extension is
/// surface, and adding a capability here means adding a line there.</para>
///
/// <para>Each feature maps its own endpoints through one extension method, so this file does not grow
/// a line per route and a feature can be deleted in one piece.</para>
/// </remarks>
internal static class Program
{
    private static async Task Main(string[] args)
    {
        WebApplicationBuilder builder = WebApplication.CreateBuilder(args);

        builder.Services.Add__SOLUTION__();

        // A severity serialised as a number is a magic number in the client: a front end that
        // switches on 0, 1 and 2 has encoded an ordering nothing guarantees, and inserting a severity
        // later silently changes what every old client displays.
        builder.Services.ConfigureHttpJsonOptions(options =>
            options.SerializerOptions.Converters.Add(new JsonStringEnumConverter()));

        // Liveness, for whatever starts this process and has to know whether it came up. Registered
        // with no checks of its own on purpose: an empty set answers 200 as soon as the host is
        // serving, which is the question an orchestrator is actually asking. A dependency worth
        // reporting on gets added here as a named check, and then it is part of the answer.
        builder.Services.AddHealthChecks();

        WebApplication app = builder.Build();

        // Deliberately not an ApiResult endpoint, and deliberately not in an Endpoints holder. A reader
        // of this route is a load balancer or an orchestrator, and what it understands is the status
        // code plus the framework's own payload -- wrapping that in this solution's envelope would make
        // the one caller that cannot be changed parse something it has never heard of.
        app.MapHealthChecks("/health");

        app.MapGreetings();

        await app.RunAsync().ConfigureAwait(false);
    }
}
