using System.Text.Json.Serialization;
using MofonCode.Core;
using __SOLUTION__.Api.Greetings;
using __SOLUTION__.Application;
using __SOLUTION__.ServiceDefaults;

namespace __SOLUTION__.Api;

/// <summary>
/// The host. Composes the solution and maps the endpoints, and does nothing else.
/// </summary>
/// <remarks>
/// <para>One call to <c>Add__SOLUTION__</c> is the whole of what this host can reach: everything
/// inside the application project is private behind the mediator, so the service-collection extension is
/// surface, and adding a capability here means adding a line there.</para>
///
/// <para>Each feature maps its own endpoints through one extension method, so this file does not grow
/// a line per route and a feature can be deleted in one piece.</para>
///
/// <para>Sealed rather than static, and that is the only reason it is not static: the host tests start
/// this process in memory through <c>WebApplicationFactory&lt;Program&gt;</c>, and a static class cannot
/// be a type argument.</para>
/// </remarks>
internal sealed class Program
{
    private static async Task Main(string[] args)
    {
        WebApplicationBuilder builder = WebApplication.CreateBuilder(args);

        // Tracing, metrics, and the names the kernel publishes them under. Every host in this solution
        // calls this and nothing else about observability, so two hosts cannot drift apart.
        builder.AddServiceDefaults();

        builder.Services.Add__SOLUTION__();

        // A severity serialised as a number is a magic number in the client: a front end that
        // switches on 0, 1 and 2 has encoded an ordering nothing guarantees, and inserting a severity
        // later silently changes what every old client displays.
        builder.Services.ConfigureHttpJsonOptions(options =>
            options.SerializerOptions.Converters.Add(new JsonStringEnumConverter()));

        // Liveness, for whatever starts this process and has to know whether it came up. Registered
        // with no checks of its own on purpose: an empty set answers 200 as soon as the host is
        // serving, which is the question an orchestrator is actually asking. A dependency worth
        // reporting on gets added here as a named check, and then it is part of the answer.
        builder.Services.AddHealthChecks();

        // The description of this api's surface. The document is generated from the routes themselves,
        // which is what stops it disagreeing with them -- a hand-kept description is discovered to be
        // wrong by whoever trusted it.
        builder.Services.AddOpenApi();

        WebApplication app = builder.Build();

        // Wires FluentResults to the logger and starts the ActivitySource and Meter that
        // AddServiceDefaults named. Without this line the kernel's spans are never created at all,
        // which looks exactly like a service nobody called.
        app.Services.UseTraceResultLogging();

        // Deliberately not an ApiResult endpoint, and deliberately not in an Endpoints holder. A reader
        // of this route is a load balancer or an orchestrator, and what it understands is the status
        // code plus the framework's own payload -- wrapping that in this solution's envelope would make
        // the one caller that cannot be changed parse something it has never heard of.
        app.MapHealthChecks("/health");

        // Development only, and that is a decision rather than a default. The shape of an api is worth
        // publishing deliberately: the document names every route, every field and every status this
        // process will answer, which is a map for anybody who should not have one. A deployment that
        // wants it public moves these three lines out of the branch and says so.
        if (app.Environment.IsDevelopment())
        {
            app.MapOpenApi();

            // Swagger UI as a renderer only: the document above is generated by
            // Microsoft.AspNetCore.OpenApi, and this package is the page that reads it. Keeping the
            // generator and the viewer separate is what lets the viewer be swapped without the
            // description changing.
            app.UseSwaggerUI(options => options.SwaggerEndpoint("/openapi/v1.json", "v1"));

            // The root, which otherwise answers 404 with no body and reads as a broken deployment to
            // anybody who opens the api in a browser.
            //
            // Written with the response's own Redirect rather than Results.Redirect, because
            // BannedSymbols.txt rules out that type and TypedResults with it. The ban is about an
            // endpoint deciding for itself what a reader is told; this sends nobody a payload.
            // Excluded from the description because it is a convenience rather than part of the api's
            // surface: a client generator that found it would emit a method for it.
            app.MapGet("/", (HttpContext http) => http.Response.Redirect("/swagger/index.html"))
                .ExcludeFromDescription();
        }

        app.MapGreetings();

        await app.RunAsync().ConfigureAwait(false);
    }
}
