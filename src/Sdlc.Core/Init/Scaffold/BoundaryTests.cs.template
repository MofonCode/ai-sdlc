using System.Text;
using FluentResults;
using Microsoft.AspNetCore.Http;
using MofonCode.Core;
using __SOLUTION__.Api;
using __SOLUTION__.Contracts.Greetings;

namespace __SOLUTION__.Tests;

/// <summary>
/// What crosses the wire.
/// </summary>
/// <remarks>
/// <para>These assert the bytes rather than a type, because the invariant is about what a reader
/// receives. The leak they guard against is not a stack trace — it is an exception's own message,
/// which FluentResults copies onto an <c>ExceptionalError</c>, so the obvious boundary code puts a
/// connection string in front of whoever called.</para>
///
/// <para>No server is started. <c>ApiResult</c> writes the response itself, so a
/// <c>DefaultHttpContext</c> with a stream for a body is the whole boundary — which is also why it
/// writes its own JSON rather than delegating to a framework factory.</para>
/// </remarks>
[TestClass]
public sealed class BoundaryTests
{
    private const string Secret =
        "Server=sql-prod-07.internal;Database=app;User Id=sa;Password=hunter2";

    [TestMethod]
    public async Task A_success_carries_the_payload_and_says_it_succeeded()
    {
        (int status, string body) = await Write(Result.Ok(new GreetResponse("Hello, Ada.")));

        Assert.AreEqual(200, status);
        StringAssert.Contains(body, "\"succeeded\":true");
        StringAssert.Contains(body, "Hello, Ada.");
    }

    [TestMethod]
    public async Task A_domain_failure_is_a_bad_request_and_the_reason_is_shown()
    {
        // A validation message was written for whoever typed the input, so it passes through. This is
        // the half of the rule people forget: hiding these would leave a front end with nothing to
        // display and a user with no idea what to change.
        (int status, string body) = await Write(
            Result.Fail<GreetResponse>("A greeting needs a name."));

        Assert.AreEqual(400, status);
        StringAssert.Contains(body, "A greeting needs a name.");
        StringAssert.Contains(body, "\"succeeded\":false");
    }

    [TestMethod]
    public async Task An_exception_is_a_server_error_and_nothing_it_knew_crosses_the_wire()
    {
        // The reason the boundary exists. Note what is asserted absent: not just the password, but the
        // server name and the exception's own type - each of which names an implementation detail of
        // something the caller has no business knowing about.
        (int status, string body) = await Write(
            Result.Fail<GreetResponse>(new ExceptionalError(new InvalidOperationException(Secret))));

        Assert.AreEqual(500, status, "Something broke here. 400 would blame the caller for it.");
        Assert.IsFalse(body.Contains("hunter2", StringComparison.Ordinal), body);
        Assert.IsFalse(body.Contains("sql-prod-07", StringComparison.Ordinal), body);
        Assert.IsFalse(body.Contains(nameof(InvalidOperationException), StringComparison.Ordinal), body);
        StringAssert.Contains(body, ResultEnvelope.SomethingWentWrong);
    }

    [TestMethod]
    public async Task A_failure_carries_the_trace_id_that_finds_what_was_withheld()
    {
        // The pair that makes withholding acceptable: the reader gets a neutral sentence and an id,
        // and the log holds everything. Without the id, hiding the detail loses it.
        (_, string body) = await Write(
            Result.Fail<GreetResponse>(new ExceptionalError(new InvalidOperationException(Secret))));

        StringAssert.Contains(body, "0HN-TEST-TRACE");
    }

    private static async Task<(int Status, string Body)> Write<T>(Result<T> result)
    {
        DefaultHttpContext context = new() { TraceIdentifier = "0HN-TEST-TRACE" };

        using MemoryStream written = new();
        context.Response.Body = written;

        await result.ToApiResult(context).ExecuteAsync(context);

        return (context.Response.StatusCode, Encoding.UTF8.GetString(written.ToArray()));
    }
}
