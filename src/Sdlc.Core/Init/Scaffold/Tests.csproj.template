<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MSTest" />

    <!-- The container, so a test composes the solution the way a host does rather than constructing a
         handler. The kernel takes only the abstractions, deliberately, so whoever hosts it chooses the
         implementation - and here that is the suite. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\__SOLUTION__.Application\__SOLUTION__.Application.csproj" />

    <!-- The boundary writes its own JSON, so asserting what crosses the wire needs no server and no
         test host - just this reference and a DefaultHttpContext. -->
    <ProjectReference Include="..\..\src\__SOLUTION__.Api\__SOLUTION__.Api.csproj" />
  </ItemGroup>

</Project>
