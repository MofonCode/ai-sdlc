{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy", "Bypass",
              "-File", "${CLAUDE_PLUGIN_ROOT}/tools/Assert-DerivedArtifact.ps1"
            ],
            "timeout": 20,
            "statusMessage": "Checking the artifact is not derived..."
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy", "Bypass",
              "-File", "${CLAUDE_PLUGIN_ROOT}/tools/Assert-DeclaredFile.ps1"
            ],
            "timeout": 20,
            "statusMessage": "Checking the plan declares this file..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy", "Bypass",
              "-File", "${CLAUDE_PLUGIN_ROOT}/tools/Assert-Landable.ps1"
            ],
            "timeout": 20,
            "statusMessage": "Checking the cycle verified clean..."
          }
        ]
      }
    ]
  }
}
