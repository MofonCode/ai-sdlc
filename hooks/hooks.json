{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sdlc hook --host claude",
            "timeout": 10,
            "statusMessage": "Asking the gate..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sdlc hook --host claude --event turn-end",
            "timeout": 10,
            "statusMessage": "Checking the build is green..."
          }
        ]
      }
    ]
  }
}
