# The factory agent as a systemd service: one fresh container per job, started on boot.
# factory/README.md says where this file goes and what the environment file holds.
[Unit]
Description=ai-sdlc factory agent, one fresh container per job
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm --force sdlc-factory-agent
ExecStart=/bin/sh -c 'exec /usr/bin/docker run --rm --name sdlc-factory-agent --env-file /etc/sdlc-factory-agent.env --group-add "$(stat -c %%g /var/run/docker.sock)" --volume /var/run/docker.sock:/var/run/docker.sock ai-sdlc-factory-agent'
ExecStop=/usr/bin/docker stop --time 30 sdlc-factory-agent

[Install]
WantedBy=multi-user.target
