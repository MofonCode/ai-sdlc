+using DiceTrial.Web.Rolling;
+
+namespace DiceTrial.Web.Tests;
+
+/// <summary>
+/// A roll source the test drives: it returns the supplied values in order, repeating the last one
+/// once the sequence runs out, and counts how many times it was asked.
+/// </summary>
+internal sealed class StubDieRoller(params int[] values) : IDieRoller
+{
+    private int _calls;
+
+    /// <summary>How many times a request has asked this source for a value.</summary>
+    public int Calls => Volatile.Read(ref _calls);
+
+    /// <inheritdoc />
+    public int Roll()
+    {
+        var index = Interlocked.Increment(ref _calls) - 1;
+        return values[Math.Min(index, values.Length - 1)];
+    }
+}
