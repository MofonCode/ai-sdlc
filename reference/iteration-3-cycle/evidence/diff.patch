+using System.Globalization;
+using AngleSharp.Dom;
+using AngleSharp.Html.Parser;
+using DiceTrial.Web.Rolling;
+
+namespace DiceTrial.Web.Tests;
+
+/// <summary>Criteria 1, 2, 5 and 6, each checked over HTTP the way a player asks for the page.</summary>
+[TestClass]
+public sealed class RollPageTests
+{
+    /// <summary>Criterion 1.</summary>
+    [TestMethod]
+    public async Task Page_presents_exactly_one_roll_with_a_value_from_1_to_6()
+    {
+        using var factory = new RollPageFactory(new RandomDieRoller());
+        using var client = factory.CreateClient();
+
+        using var response = await client.GetAsync(new Uri("/", UriKind.Relative));
+        var document = await ParseAsync(response);
+
+        var rolls = document.QuerySelectorAll("[data-testid='roll']");
+        Assert.AreEqual(1, rolls.Length, "the page must present exactly one roll");
+
+        var text = rolls[0].TextContent.Trim();
+        Assert.IsTrue(
+            int.TryParse(text, NumberStyles.None, CultureInfo.InvariantCulture, out var value),
+            $"the roll must be an integer, but the page showed '{text}'");
+        Assert.IsTrue(value is >= 1 and <= 6, $"the roll must be from 1 to 6, but the page showed {value}");
+    }
+
+    /// <summary>Criterion 2.</summary>
+    [TestMethod]
+    public async Task Each_response_presents_the_value_its_own_request_rolled()
+    {
+        var roller = new StubDieRoller(3, 3, 5);
+        using var factory = new RollPageFactory(roller);
+        using var client = factory.CreateClient();
+
+        var served = new List<int>();
+        for (var request = 0; request < 3; request++)
+        {
+            using var response = await client.GetAsync(new Uri("/", UriKind.Relative));
+            served.Add(await ReadRollAsync(response));
+        }
+
+        CollectionAssert.AreEqual(
+            new[] { 3, 3, 5 },
+            served,
+            "each response must show the value its own request drew: a constant, a value fixed at "
+            + "start-up, or a cached response would not track the source");
+        Assert.AreEqual(3, roller.Calls, "the source must be asked exactly once per request");
+    }
+
+    /// <summary>Criterion 5.</summary>
+    [TestMethod]
+    public async Task Player_supplied_values_do_not_change_the_roll()
+    {
+        using var factory = new RollPageFactory(new StubDieRoller(2));
+        using var client = factory.CreateClient();
+
+        using var query = await client.GetAsync(new Uri("/?value=6", UriKind.Relative));
+        await AssertNoPlayerValueAsync(query);
+
+        using var otherQuery = await client.GetAsync(new Uri("/?roll=6", UriKind.Relative));
+        await AssertNoPlayerValueAsync(otherQuery);
+
+        using var headerRequest = new HttpRequestMessage(HttpMethod.Get, new Uri("/", UriKind.Relative));
+        headerRequest.Headers.Add("X-Roll", "6");
+        using var header = await client.SendAsync(headerRequest);
+        await AssertNoPlayerValueAsync(header);
+
+        using var body = new FormUrlEncodedContent([new KeyValuePair<string, string>("value", "6")]);
+        using var posted = await client.PostAsync(new Uri("/", UriKind.Relative), body);
+        await AssertNoPlayerValueAsync(posted);
+    }
+
+    /// <summary>Criterion 6.</summary>
+    [TestMethod]
+    public async Task The_roll_arrives_as_an_html_document_whose_text_shows_it()
+    {
+        using var factory = new RollPageFactory(new StubDieRoller(5));
+        using var client = factory.CreateClient();
+
+        using var response = await client.GetAsync(new Uri("/", UriKind.Relative));
+        response.EnsureSuccessStatusCode();
+
+        Assert.AreEqual(
+            "text/html",
+            response.Content.Headers.ContentType?.MediaType,
+            "a bare data payload is not a page a player can open");
+
+        var document = await ParseAsync(response);
+        Assert.IsNotNull(document.DocumentElement, "the response must parse as an HTML document");
+        Assert.AreEqual("HTML", document.DocumentElement.TagName, "the root element must be html");
+        Assert.IsNotNull(document.Body, "the document must have a body for a reader to see");
+        StringAssert.Contains(
+            document.Body.TextContent,
+            "5",
+            "the rolled value must appear in the text the document renders, not only in markup a "
+            + "reader never sees");
+    }
+
+    /// <summary>Reads the single roll the page presents.</summary>
+    internal static async Task<int> ReadRollAsync(HttpResponseMessage response)
+    {
+        var document = await ParseAsync(response);
+        var rolls = document.QuerySelectorAll("[data-testid='roll']");
+        Assert.AreEqual(1, rolls.Length, "the page must present exactly one roll");
+        return int.Parse(rolls[0].TextContent.Trim(), CultureInfo.InvariantCulture);
+    }
+
+    /// <summary>Parses a response body as HTML.</summary>
+    internal static async Task<IDocument> ParseAsync(HttpResponseMessage response)
+    {
+        var html = await response.Content.ReadAsStringAsync();
+        var parser = new HtmlParser();
+        return await parser.ParseDocumentAsync(html);
+    }
+
+    /// <summary>
+    /// A response either presents the value the source gave, or presents no page at all because the
+    /// request was refused. Either satisfies criterion 5; rendering the requested 6 does not.
+    /// </summary>
+    private static async Task AssertNoPlayerValueAsync(HttpResponseMessage response)
+    {
+        if (!response.IsSuccessStatusCode)
+        {
+            return;
+        }
+
+        Assert.AreEqual(
+            2,
+            await ReadRollAsync(response),
+            "nothing a player sends may change the rolled value");
+    }
+}
