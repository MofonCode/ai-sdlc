+using DiceTrial.Web.Components;
+using DiceTrial.Web.Rolling;
+
+var builder = WebApplication.CreateBuilder(args);
+
+// Static server rendering only: no interactive render mode, so no circuit and no per-visitor state.
+builder.Services.AddRazorComponents();
+builder.Services.AddSingleton<IDieRoller, RandomDieRoller>();
+
+var app = builder.Build();
+
+app.UseAntiforgery();
+app.MapRazorComponents<App>();
+
+app.Run();
+
+// Lets the in-memory test host reference the entry point; top-level statements make it internal.
+public partial class Program;
