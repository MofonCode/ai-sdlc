@@ -0,0 +1,63 @@
+using DiceTrial.Web.Rolling;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+
+namespace DiceTrial.Web.Tests;
+
+/// <summary>
+/// Hosts the page in memory with its roll source replaced by one the test drives.
+/// </summary>
+/// <remarks>
+/// When <paramref name="contentRoot"/> and <paramref name="tempRoot"/> are supplied, the host runs
+/// with its content root in the first and resolves <c>Path.GetTempPath()</c> to the second, so that
+/// criterion 3's snapshot watches directories only this test writes to. The temp redirection is done
+/// with environment variables, which are process-wide: this factory restores them on dispose, and a
+/// test that uses it must not run alongside another that cares about the temp path.
+/// </remarks>
+internal sealed class RollPageFactory(IDieRoller roller, string? contentRoot = null, string? tempRoot = null)
+    : WebApplicationFactory<Program>
+{
+    private static readonly string[] TempVariables = ["TMP", "TEMP", "TMPDIR"];
+
+    private readonly Dictionary<string, string?> _replacedTempVariables = [];
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        if (contentRoot is not null)
+        {
+            builder.UseContentRoot(contentRoot);
+        }
+
+        if (tempRoot is not null)
+        {
+            foreach (var variable in TempVariables)
+            {
+                _replacedTempVariables[variable] = Environment.GetEnvironmentVariable(variable);
+                Environment.SetEnvironmentVariable(variable, tempRoot);
+            }
+        }
+
+        builder.ConfigureServices(services =>
+        {
+            services.RemoveAll<IDieRoller>();
+            services.AddSingleton(roller);
+        });
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing)
+        {
+            foreach (var (variable, value) in _replacedTempVariables)
+            {
+                Environment.SetEnvironmentVariable(variable, value);
+            }
+
+            _replacedTempVariables.Clear();
+        }
+
+        base.Dispose(disposing);
+    }
+}
