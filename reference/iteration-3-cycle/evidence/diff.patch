+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace DiceTrial.Web.Tests;
+
+/// <summary>Criterion 4: the page establishes, requests and requires no identity.</summary>
+[TestClass]
+public sealed class NoIdentityTests
+{
+    private static readonly string[] IdentityWords = ["verification", "antiforgery", "session", "csrf"];
+
+    /// <summary>Criterion 4.</summary>
+    [TestMethod]
+    public async Task A_response_sets_no_cookie_and_asks_the_player_for_nothing()
+    {
+        using var factory = new RollPageFactory(new StubDieRoller(4));
+        using var client = factory.CreateClient(new WebApplicationFactoryClientOptions
+        {
+            AllowAutoRedirect = false,
+            HandleCookies = false,
+        });
+
+        using var response = await client.GetAsync(new Uri("/", UriKind.Relative));
+
+        Assert.IsFalse(
+            response.Headers.Contains("Set-Cookie"),
+            "a response that sets a cookie has started identifying the player");
+
+        var document = await RollPageTests.ParseAsync(response);
+
+        Assert.AreEqual(
+            0,
+            document.QuerySelectorAll("input").Length,
+            "the page must ask the player for nothing before showing a roll");
+
+        foreach (var element in document.All)
+        {
+            foreach (var attribute in element.Attributes)
+            {
+                var text = $"{attribute.Name} {attribute.Value}";
+                foreach (var word in IdentityWords)
+                {
+                    Assert.IsFalse(
+                        text.Contains(word, StringComparison.OrdinalIgnoreCase),
+                        $"'{word}' appears in the page at <{element.TagName.ToLowerInvariant()} "
+                        + $"{attribute.Name}='{attribute.Value}'>, which means the page carries a token "
+                        + "or session of some kind");
+                }
+            }
+        }
+
+        Assert.AreEqual(
+            4,
+            await RollPageTests.ReadRollAsync(response),
+            "the roll must be served to a client holding no prior state");
+    }
+}
diff --git a/tests/DiceTrial.Web.Tests/NoPersistenceTests.cs b/tests/DiceTrial.Web.Tests/NoPersistenceTests.cs
new file mode 100644
index 0000000..dfc4e82
--- /dev/null
+++ b/tests/DiceTrial.Web.Tests/NoPersistenceTests.cs
@@ -0,0 +1,209 @@
+using System.Xml.Linq;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Hosting;
+
+namespace DiceTrial.Web.Tests;
+
+/// <summary>
+/// Criterion 3: nothing about a roll outlives the response that carried it. Three checks, because no
+/// one of them reaches the whole criterion — and what none of them reaches is recorded in the plan
+/// under Cannot prove rather than claimed here.
+/// </summary>
+[TestClass]
+public sealed class NoPersistenceTests
+{
+    private const int RequestsPerRun = 10;
+
+    /// <summary>Words that name a store in a registered service type.</summary>
+    private static readonly string[] StoreWords =
+        ["DbContext", "DbConnection", "ConnectionFactory", "SqlClient", "Cosmos", "Redis", "Mongo", "Sqlite"];
+
+    /// <summary>Criterion 3, the file half.</summary>
+    [TestMethod]
+    public async Task Serving_rolls_creates_modifies_or_deletes_no_file()
+    {
+        var contentRoot = CreateRunDirectory("content");
+        var tempRoot = CreateRunDirectory("temp");
+
+        try
+        {
+            string[] watched =
+            [
+                contentRoot,
+                tempRoot,
+                Environment.CurrentDirectory,
+                .. DataProtectionKeyDirectories(),
+            ];
+
+            using var factory = new RollPageFactory(new StubDieRoller(6), contentRoot, tempRoot);
+
+            // Creating the client starts the host, so start-up is outside the window and every
+            // response is inside it - including the first, which is when anything initialised on
+            // first use would be written.
+            using var client = factory.CreateClient();
+
+            var before = Snapshot(watched);
+
+            for (var request = 0; request < RequestsPerRun; request++)
+            {
+                using var response = await client.GetAsync(new Uri("/", UriKind.Relative));
+                response.EnsureSuccessStatusCode();
+            }
+
+            var after = Snapshot(watched);
+
+            var added = after.Keys.Except(before.Keys, StringComparer.OrdinalIgnoreCase).Order().ToArray();
+            var removed = before.Keys.Except(after.Keys, StringComparer.OrdinalIgnoreCase).Order().ToArray();
+            var changed = before.Keys
+                .Intersect(after.Keys, StringComparer.OrdinalIgnoreCase)
+                .Where(path => before[path] != after[path])
+                .Order()
+                .ToArray();
+
+            Assert.AreEqual(0, added.Length, $"serving rolls created: {string.Join(", ", added)}");
+            Assert.AreEqual(0, removed.Length, $"serving rolls deleted: {string.Join(", ", removed)}");
+            Assert.AreEqual(0, changed.Length, $"serving rolls modified: {string.Join(", ", changed)}");
+        }
+        finally
+        {
+            Delete(contentRoot);
+            Delete(tempRoot);
+        }
+    }
+
+    /// <summary>Criterion 3, the store half.</summary>
+    [TestMethod]
+    public async Task No_store_is_configured_or_registered()
+    {
+        IServiceCollection? registered = null;
+
+        using var factory = new RollPageFactory(new StubDieRoller(6));
+        using var configured = factory.WithWebHostBuilder(
+            builder => builder.ConfigureServices(services => registered = services));
+        using var client = configured.CreateClient();
+
+        using var response = await client.GetAsync(new Uri("/", UriKind.Relative));
+        response.EnsureSuccessStatusCode();
+
+        var configuration = configured.Services.GetRequiredService<IConfiguration>();
+        Assert.AreEqual(
+            0,
+            configuration.GetSection("ConnectionStrings").GetChildren().Count(),
+            "a connection string means something is expected to hold data");
+
+        Assert.IsNotNull(registered, "the host must have composed its services");
+        foreach (var descriptor in registered)
+        {
+            var names = $"{descriptor.ServiceType.FullName} {descriptor.ImplementationType?.FullName}";
+            foreach (var word in StoreWords)
+            {
+                Assert.IsFalse(
+                    names.Contains(word, StringComparison.OrdinalIgnoreCase),
+                    $"'{word}' appears in the registration {names}, so a store is wired into the app");
+            }
+        }
+    }
+
+    /// <summary>
+    /// A tripwire, and nothing more: it establishes that the web project takes no third-party
+    /// dependency. It does not establish that no roll is recorded anywhere, because the framework
+    /// alone can reach a remote store with no package at all.
+    /// </summary>
+    [TestMethod]
+    public void The_web_project_declares_no_package_reference()
+    {
+        var project = Path.Combine(RepositoryRoot(), "src", "DiceTrial.Web", "DiceTrial.Web.csproj");
+        Assert.IsTrue(File.Exists(project), $"the web project should be at {project}");
+
+        var references = XDocument.Load(project)
+            .Descendants("PackageReference")
+            .Select(element => element.Attribute("Include")?.Value ?? "(unnamed)")
+            .ToArray();
+
+        Assert.AreEqual(
+            0,
+            references.Length,
+            $"the web project declares: {string.Join(", ", references)}");
+    }
+
+    private static string CreateRunDirectory(string purpose)
+    {
+        var path = Path.Combine(
+            Path.GetTempPath(),
+            $"dice-trial-{purpose}-{Guid.NewGuid():n}");
+        Directory.CreateDirectory(path);
+        return path;
+    }
+
+    private static IEnumerable<string> DataProtectionKeyDirectories()
+    {
+        var localAppData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+        if (localAppData.Length > 0)
+        {
+            yield return Path.Combine(localAppData, "ASP.NET", "DataProtection-Keys");
+        }
+
+        var profile = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
+        if (profile.Length > 0)
+        {
+            yield return Path.Combine(profile, ".aspnet", "DataProtection-Keys");
+        }
+    }
+
+    /// <summary>
+    /// Every file under each watched root, with the signature that reveals a write. A root that does
+    /// not exist is recorded as absent, so a directory appearing mid-run shows up as a difference.
+    /// The test runner's own results directory is excluded: that output is the runner writing, not the
+    /// application recording a roll.
+    /// </summary>
+    private static Dictionary<string, string> Snapshot(IEnumerable<string> roots)
+    {
+        var snapshot = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+
+        foreach (var root in roots)
+        {
+            snapshot[$"(exists) {root}"] = Directory.Exists(root).ToString();
+
+            if (!Directory.Exists(root))
+            {
+                continue;
+            }
+
+            foreach (var file in Directory.EnumerateFiles(root, "*", SearchOption.AllDirectories))
+            {
+                if (file.Contains($"{Path.DirectorySeparatorChar}TestResults{Path.DirectorySeparatorChar}",
+                        StringComparison.OrdinalIgnoreCase))
+                {
+                    continue;
+                }
+
+                var info = new FileInfo(file);
+                snapshot[file] = $"{info.Length}/{info.LastWriteTimeUtc.Ticks}";
+            }
+        }
+
+        return snapshot;
+    }
+
+    private static string RepositoryRoot()
+    {
+        var directory = new DirectoryInfo(AppContext.BaseDirectory);
+        while (directory is not null && !Directory.Exists(Path.Combine(directory.FullName, ".git")))
+        {
+            directory = directory.Parent;
+        }
+
+        Assert.IsNotNull(directory, "the tests should run inside the repository");
+        return directory.FullName;
+    }
+
+    private static void Delete(string path)
+    {
+        if (Directory.Exists(path))
+        {
+            Directory.Delete(path, recursive: true);
+        }
+    }
+}
