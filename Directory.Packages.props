<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="MSTest" Version="4.4.1" />

    <!-- The container itself. MofonCode.Core takes only the abstractions, deliberately, so the
         host is what chooses an implementation. Latest stable 10.x, resolved rather than guessed. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />

    <!-- The shared kernel, and the mediator this repository dispatches through. MIT, and it
         depends only on FluentResults and the Microsoft.Extensions.*.Abstractions packages,
         so taking it commits a consumer to no data story. Pinned because every solution
         taking it inherits its breaking changes, and it is pre-1.0. -->
    <PackageVersion Include="MofonCode.Core" Version="0.1.0" />

    <!-- JSON Schema 2020-12 validation. System.Text.Json does not validate schemas and
         Microsoft publishes no validator, so this is the absence of an on-stack option
         rather than a departure from the default stack. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />

    <!-- YAML, on the same standing: .NET ships no YAML reader, and artifact frontmatter has
         to be read by a real parser. It exists because a hand-rolled frontmatter regex in
         v02 reported that a skill declared disable-model-invocation while the real parser
         had dropped every field in the file - the skill was model-invocable at runtime and
         333 tests said otherwise. A check on markup is worth only what the parser behind it
         is. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
